{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "description": "Capability grant for a service.",
      "properties": {
        "environment": {
          "enum": [
            "dev",
            "staging",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "mode": {
          "default": "both",
          "enum": [
            "secret_resolution",
            "proxy_only",
            "both"
          ],
          "title": "Mode",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "service": {
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "scopes",
        "environment"
      ],
      "title": "Capability",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent session initiation request.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "default": "0.0.0",
      "title": "Agent Version",
      "type": "string"
    },
    "avp_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Avp Version",
      "type": "string"
    },
    "metadata": {
      "title": "Metadata",
      "type": "object"
    },
    "requested_capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Requested Capabilities",
      "type": "array"
    },
    "runtime": {
      "default": "unknown",
      "title": "Runtime",
      "type": "string"
    },
    "type": {
      "const": "agent_hello",
      "default": "agent_hello",
      "enum": [
        "agent_hello"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "requested_capabilities"
  ],
  "title": "AgentHello",
  "type": "object"
}

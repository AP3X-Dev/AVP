{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response containing resolved secrets.",
  "properties": {
    "avp_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Avp Version",
      "type": "string"
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "prod"
      ],
      "title": "Environment",
      "type": "string"
    },
    "secrets": {
      "title": "Secrets",
      "type": "object"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "secret_bundle",
      "default": "secret_bundle",
      "enum": [
        "secret_bundle"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "environment",
    "secrets"
  ],
  "title": "SecretBundle",
  "type": "object"
}

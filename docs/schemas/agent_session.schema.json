{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "description": "Capability grant for a service.",
      "properties": {
        "environment": {
          "enum": [
            "dev",
            "staging",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "mode": {
          "default": "both",
          "enum": [
            "secret_resolution",
            "proxy_only",
            "both"
          ],
          "title": "Mode",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "service": {
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "scopes",
        "environment"
      ],
      "title": "Capability",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent session response after successful hello.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "avp_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Avp Version",
      "type": "string"
    },
    "capability_handles": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Capability Handles",
      "type": "object"
    },
    "constraints": {
      "title": "Constraints",
      "type": "object"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "granted_capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Granted Capabilities",
      "type": "array"
    },
    "principal_id": {
      "title": "Principal Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "session_token": {
      "title": "Session Token",
      "type": "string"
    },
    "type": {
      "const": "agent_session",
      "default": "agent_session",
      "enum": [
        "agent_session"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "session_token",
    "agent_id",
    "principal_id",
    "granted_capabilities",
    "expires_at"
  ],
  "title": "AgentSession",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AVP error envelope format.",
  "properties": {
    "avp_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Avp Version",
      "type": "string"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "details": {
      "title": "Details",
      "type": "object"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "type": {
      "const": "error",
      "default": "error",
      "enum": [
        "error"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "AVPError",
  "type": "object"
}
